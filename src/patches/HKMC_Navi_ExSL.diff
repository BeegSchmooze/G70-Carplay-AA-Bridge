+.class public final Lcom/mnsoft/navi/LeafiaTbtMute;
+.super Ljava/lang/Object;
+.source "LeafiaTbtMute.java"
+
+# While a phone (CarPlay or Android Auto) is guiding, DiPO / GPM stamp
+# sys.leafia.phonetbt with SystemClock.elapsedRealtime() seconds each time they
+# send a turn to the cluster. The car navigation keeps sending its own turn frames
+# every couple of seconds (even with no route), which overwrote the phone's.
+# Its turn display frames are skipped while the stamp is under 90 s old; speed
+# camera / trap frames and the HUD warning distance still go through.
+
+.field private static sMuted:Z
+
+# G70 diagnostic: the last turn-list frame logged
+.field private static sLastFrame:Ljava/lang/String;
+
+
